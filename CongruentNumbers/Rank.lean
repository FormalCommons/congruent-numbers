module

public import CongruentNumbers.Torsion
public import CongruentNumbers.Triangle
public import TauCeti.AlgebraicGeometry.EllipticCurve.MordellWeil.FinitelyGenerated

/-!
# Congruent numbers and the rank of `E_n`

This file formalizes the milestone *Congruent numbers and the rank of E_n* of the plan
<https://github.com/FormalCommons/congruent-numbers-plan/blob/main/atlas/rational-points.md>.

A positive integer `n` is congruent if and only if `E_n(ℚ)` has a point of infinite order, if and
only if `E_n(ℚ)` is infinite, if and only if its rank `Module.finrank ℤ E_n(ℚ)` is positive.

By *Right triangles and points of E_n* (`isCongruent_iff_exists_two_nsmul_ne_zero`), `n` is
congruent if and only if `E_n(ℚ)` has a point `P` with `-P ≠ P`, and by *Torsion of E_n*
(`mem_torsion_iff_neg_eq_self`) these are exactly the points of infinite order. Since the torsion
subgroup is finite (`card_torsion`), `E_n(ℚ)` is infinite if and only if it has a point of infinite
order. Finally, `E_n(ℚ)` is a finitely generated `ℤ`-module by the Mordell–Weil theorem
(Tau Ceti's `moduleFinite_point_of_numberField`), so its rank is positive if and only if it is not
a torsion group.

## Main results

* `CongruentNumbers.isCongruent_iff_exists_not_isOfFinAddOrder`: `n` is congruent if and only if
  `E_n(ℚ)` has a point of infinite order.
* `CongruentNumbers.isCongruent_iff_infinite`: `n` is congruent if and only if `E_n(ℚ)` is
  infinite.
* `CongruentNumbers.isCongruent_iff_finrank_pos`: `n` is congruent if and only if the rank of
  `E_n(ℚ)` is positive.
* `CongruentNumbers.isCongruent_tfae`: the milestone, as a list of equivalent statements.

## References

* [N. Koblitz, *Introduction to Elliptic Curves and Modular Forms*][Koblitz1993], §I.9, Prop. 18.
-/

public section

open WeierstrassCurve

namespace CongruentNumbers

variable {n : ℤ}

/-- For a nonzero integer `n`, `E_n(ℚ)` has a point of infinite order if and only if it is
infinite, since its torsion subgroup is finite. -/
theorem exists_not_isOfFinAddOrder_iff_infinite (hn : n ≠ 0) :
    (∃ P : (curve (n : ℚ)).toAffine.Point, ¬IsOfFinAddOrder P) ↔
      Infinite (curve (n : ℚ)).toAffine.Point := by
  have : NeZero n := ⟨hn⟩
  constructor
  · rintro ⟨P, hP⟩
    by_contra h
    have : Finite (curve (n : ℚ)).toAffine.Point := not_infinite_iff_finite.mp h
    exact hP (isOfFinAddOrder_of_finite P)
  · intro h
    by_contra hP
    push Not at hP
    have : Finite (AddCommGroup.torsion (curve (n : ℚ)).toAffine.Point) :=
      Nat.finite_of_card_ne_zero (by simp [card_torsion])
    have : Finite (curve (n : ℚ)).toAffine.Point :=
      Finite.of_surjective (fun P : AddCommGroup.torsion _ ↦ (P : (curve (n : ℚ)).toAffine.Point))
        fun P ↦ ⟨⟨P, hP P⟩, rfl⟩
    exact not_finite (curve (n : ℚ)).toAffine.Point

/-- For a nonzero integer `n`, `E_n(ℚ)` has a point of infinite order if and only if its rank is
positive, since `E_n(ℚ)` is finitely generated by the Mordell–Weil theorem. -/
theorem exists_not_isOfFinAddOrder_iff_finrank_pos (hn : n ≠ 0) :
    (∃ P : (curve (n : ℚ)).toAffine.Point, ¬IsOfFinAddOrder P) ↔
      0 < Module.finrank ℤ (curve (n : ℚ)).toAffine.Point := by
  have : NeZero n := ⟨hn⟩
  have : NeZero (n : ℚ) := ⟨Int.cast_ne_zero.mpr hn⟩
  rw [Nat.pos_iff_ne_zero, Ne, Module.finrank_eq_zero_iff]
  simp only [isOfFinAddOrder_iff_zsmul_eq_zero, not_exists, not_and, not_forall]

/-- **Congruent numbers and the rank of E_n**: a positive integer `n` is congruent if and only if
`E_n(ℚ)` has a point of infinite order.

This is the milestone *Congruent numbers and the rank of E_n* (the point of infinite order). -/
theorem isCongruent_iff_exists_not_isOfFinAddOrder (hn : 0 < n) :
    IsCongruent (n : ℚ) ↔ ∃ P : (curve (n : ℚ)).toAffine.Point, ¬IsOfFinAddOrder P := by
  have : NeZero n := ⟨hn.ne'⟩
  have : NeZero (n : ℚ) := ⟨Int.cast_ne_zero.mpr hn.ne'⟩
  rw [isCongruent_iff_exists_two_nsmul_ne_zero (Int.cast_pos.mpr hn)]
  refine exists_congr fun P ↦ ?_
  rw [← AddCommGroup.mem_torsion, mem_torsion_iff_neg_eq_self, two_nsmul, Ne,
    add_eq_zero_iff_eq_neg, eq_comm]

/-- **Congruent numbers and the rank of E_n**: a positive integer `n` is congruent if and only if
`E_n(ℚ)` is infinite.

This is the milestone *Congruent numbers and the rank of E_n* (infinitely many points). -/
theorem isCongruent_iff_infinite (hn : 0 < n) :
    IsCongruent (n : ℚ) ↔ Infinite (curve (n : ℚ)).toAffine.Point := by
  rw [isCongruent_iff_exists_not_isOfFinAddOrder hn, exists_not_isOfFinAddOrder_iff_infinite hn.ne']

/-- **Congruent numbers and the rank of E_n**: a positive integer `n` is congruent if and only if
the rank of `E_n(ℚ)` is positive.

This is the milestone *Congruent numbers and the rank of E_n* (positive rank). -/
theorem isCongruent_iff_finrank_pos (hn : 0 < n) :
    IsCongruent (n : ℚ) ↔ 0 < Module.finrank ℤ (curve (n : ℚ)).toAffine.Point := by
  rw [isCongruent_iff_exists_not_isOfFinAddOrder hn,
    exists_not_isOfFinAddOrder_iff_finrank_pos hn.ne']

/-- **Congruent numbers and the rank of E_n**: for a positive integer `n`, the following are
equivalent: `n` is congruent; `E_n(ℚ)` has a point of infinite order; `E_n(ℚ)` is infinite; the
rank of `E_n(ℚ)` is positive.

This is the milestone *Congruent numbers and the rank of E_n*. -/
theorem isCongruent_tfae (hn : 0 < n) :
    List.TFAE [IsCongruent (n : ℚ),
      ∃ P : (curve (n : ℚ)).toAffine.Point, ¬IsOfFinAddOrder P,
      Infinite (curve (n : ℚ)).toAffine.Point,
      0 < Module.finrank ℤ (curve (n : ℚ)).toAffine.Point] := by
  tfae_have 1 ↔ 2 := isCongruent_iff_exists_not_isOfFinAddOrder hn
  tfae_have 2 ↔ 3 := exists_not_isOfFinAddOrder_iff_infinite hn.ne'
  tfae_have 2 ↔ 4 := exists_not_isOfFinAddOrder_iff_finrank_pos hn.ne'
  tfae_finish

end CongruentNumbers

end
